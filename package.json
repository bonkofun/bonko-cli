{
  "name": "@bonkofun/cli",
  "version": "0.1.0",
  "description": "Local Bonko template creation, preview, build and verification CLI",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "bonko": "bin/bonko.mjs"
  },
  "files": [
    "bin",
    "dist-cli",
    "engine",
    "studio-dist",
    "scaffolds",
    "docs/PROTOCOL.md",
    "README.md",
    "PROVENANCE.md",
    "npm-shrinkwrap.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-studio.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.studio.json",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "release": "npm run build && node scripts/release.mjs"
  },
  "dependencies": {
    "@bonko/template-sdk": "0.2.3",
    "@playwright/test": "1.63.0",
    "@tabler/icons-react": "3.46.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.13.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion": "13.1.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-mockframe": "1.1.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.7.3",
    "vite": "8.2.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonkofun/bonko-cli.git"
  },
  "homepage": "https://github.com/bonkofun/bonko-cli#readme",
  "bugs": {
    "url": "https://github.com/bonkofun/bonko-cli/issues"
  }
}
